<codeline><highlight class="normal">##<sp/>📊<sp/>Technical<sp/>Schematics</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">###<sp/>🧩<sp/>High-Level<sp/>Class<sp/>Hierarchy</highlight></codeline>
<codeline><highlight class="normal">```mermaid</highlight></codeline>
<codeline><highlight class="normal">classDiagram</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>direction<sp/>TB</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>class<sp/>IInteractable<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>&lt;&lt;interface&gt;&gt;</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>+bool<sp/>IsInteractable</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>+Interact(PlayerController<sp/>player)</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>}</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>class<sp/>Switch<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>+int<sp/>switchId</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>+Interact(PlayerController<sp/>player)</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>}</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>class<sp/>PressurePlate<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>+int<sp/>plateId</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>+OnTriggerEnter()</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>}</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>class<sp/>EventBus<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>&lt;&lt;static&gt;&gt;</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>+Action~int~<sp/>OnSwitchActivated</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>+Action~List~FrameData~~<sp/>OnEchoRecorded</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>}</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>class<sp/>EchoRecorder<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>-List~FrameData~<sp/>_recordBuffer</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>+StartRecording()</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>+StopRecording()</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>}</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>class<sp/>EchoClone<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>+Initialize(List~FrameData~<sp/>data)</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>+PlayNextFrame()</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>}</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>IInteractable<sp/>&lt;|..<sp/>Switch<sp/>:<sp/>Realizes</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>IInteractable<sp/>&lt;|..<sp/>PressurePlate<sp/>:<sp/>Realizes</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>Switch<sp/>..&gt;<sp/>EventBus<sp/>:<sp/>Publishes<sp/>Event</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>PressurePlate<sp/>..&gt;<sp/>EventBus<sp/>:<sp/>Publishes<sp/>Event</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>EchoRecorder<sp/>..&gt;<sp/>EventBus<sp/>:<sp/>Notifies<sp/>Playback</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>EventBus<sp/>&lt;..<sp/>EchoClone<sp/>:<sp/>Spawned<sp/>via<sp/>Event</highlight></codeline>
<codeline><highlight class="normal">```</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">###<sp/>⏳<sp/>The<sp/>Echo<sp/>Lifecycle</highlight></codeline>
<codeline><highlight class="normal">```mermaid</highlight></codeline>
<codeline><highlight class="normal">sequenceDiagram</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>participant<sp/>P<sp/>as<sp/>Player</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>participant<sp/>R<sp/>as<sp/>EchoRecorder</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>participant<sp/>B<sp/>as<sp/>EventBus</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>participant<sp/>C<sp/>as<sp/>EchoClone</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>P-&gt;&gt;R:<sp/>Trigger<sp/>Start<sp/>(Input)</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>note<sp/>over<sp/>R:<sp/>Buffer<sp/>data<sp/>for<sp/>5s</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>R--&gt;&gt;R:<sp/>Cache<sp/>Transform<sp/>&amp;<sp/>Input</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>R-&gt;&gt;B:<sp/>Broadcast<sp/>OnEchoRecorded(buffer)</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>B-&gt;&gt;C:<sp/>Instantiate<sp/>Clone</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>activate<sp/>C</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>loop<sp/>Replay<sp/>Frames</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>C-&gt;&gt;C:<sp/>Apply<sp/>Cached<sp/>TransformData</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>end</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>C-&gt;&gt;C:<sp/>Execute<sp/>Self-Destruct</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>deactivate<sp/>C</highlight></codeline>
<codeline><highlight class="normal">```</highlight></codeline>
<codeline></codeline>
